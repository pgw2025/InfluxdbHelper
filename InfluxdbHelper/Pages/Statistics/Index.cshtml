@page
@model InfluxdbHelper.Pages.Statistics.IndexModel
@{
    ViewData["Title"] = "数据统计";

    // 格式化 DateTime 为 datetime-local 输入框所需的格式 (YYYY-MM-DDTHH:mm)
    string FormatDateTimeLocal(DateTime? dateTime)
    {
        if (!dateTime.HasValue)
        {
            return string.Empty;
        }
        return dateTime.Value.ToString("yyyy-MM-ddTHH:mm");
    }
}

<div class="container-fluid card-mobile-padding">
    <h1 class="mt-4 mb-4 display-4-mobile">InfluxDB 数据统计</h1>

    @if (!Model.ConnectionOk)
    {
        <div class="alert alert-danger" role="alert">
            <strong>连接错误!</strong> 无法连接到InfluxDB数据库，请检查配置。
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- 时间段选择按钮 - 移动端适配 -->
    <div class="mb-4">
        <div class="d-grid gap-2 d-md-block">
            <form method="post" asp-page-handler="ChangePeriod" class="d-inline-block mb-1">
                <input type="hidden" name="period" value="day" />
                <button type="submit" class="btn @(Model.Period == "day" ? "btn-primary" : "btn-outline-primary") btn-mobile-full">今日</button>
            </form>

            <form method="post" asp-page-handler="ChangePeriod" class="d-inline-block mb-1">
                <input type="hidden" name="period" value="yesterday" />
                <button type="submit" class="btn @(Model.Period == "yesterday" ? "btn-primary" : "btn-outline-primary") btn-mobile-full">昨日</button>
            </form>

            <form method="post" asp-page-handler="ChangePeriod" class="d-inline-block mb-1">
                <input type="hidden" name="period" value="daybefore" />
                <button type="submit" class="btn @(Model.Period == "daybefore" ? "btn-primary" : "btn-outline-primary") btn-mobile-full">前日</button>
            </form>

            <form method="post" asp-page-handler="ChangePeriod" class="d-inline-block mb-1">
                <input type="hidden" name="period" value="week" />
                <button type="submit" class="btn @(Model.Period == "week" ? "btn-primary" : "btn-outline-primary") btn-mobile-full">本周</button>
            </form>

            <form method="post" asp-page-handler="ChangePeriod" class="d-inline-block mb-1">
                <input type="hidden" name="period" value="month" />
                <button type="submit" class="btn @(Model.Period == "month" ? "btn-primary" : "btn-outline-primary") btn-mobile-full">本月</button>
            </form>

            <button type="button" class="btn @(Model.Period == "custom" ? "btn-primary" : "btn-outline-primary") btn-mobile-full mb-1" id="customTimeBtn" data-bs-toggle="collapse" data-bs-target="#customTimeRange">自定义</button>
        </div>

        <!-- 自定义时间范围 -->
        <div class="collapse @(Model.Period == "custom" ? "show" : "")" id="customTimeRange">
            <div class="card card-body mt-2">
                <form method="get" id="customTimeForm">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-5 col-12">
                            <label for="customStartTime" class="form-label">开始时间</label>
                            <input type="datetime-local" class="form-control" id="customStartTime" name="CustomStartTime" value="@FormatDateTimeLocal(Model.CustomStartTime)" />
                        </div>
                        <div class="col-md-5 col-12">
                            <label for="customEndTime" class="form-label">结束时间</label>
                            <input type="datetime-local" class="form-control" id="customEndTime" name="CustomEndTime" value="@FormatDateTimeLocal(Model.CustomEndTime)" />
                        </div>
                        <div class="col-md-2 col-12">
                            <button type="submit" class="btn btn-primary btn-mobile-full">查询</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (!Model.IsHistoryQuery) // 仅在非历史查询模式下显示总统计和变量统计
    {
        <!-- 总数据统计卡片 -->
        <div class="row mb-4">
            <div class="col-12 stats-card-mobile">
                <div class="card text-white bg-primary">
                    <div class="card-body text-center">
                        <h5 class="card-title">总数据条数</h5>
                        <h2 class="display-6">@(Model.TotalStatistics?.TotalCount ?? 0)</h2>
                        <p class="card-text mb-0">
                            @(Model.Period == "day" ? "今日" : Model.Period == "week" ? "本周" : "本月")
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 变量统计表格 -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">各变量数据条数</h5>
            </div>
            <div class="card-body">
                @if (Model.VariableStatistics != null && Model.VariableStatistics.Any())
                {
                    <div class="table-responsive-mobile">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>变量名称</th>
                                    <th>数据条数</th>
                                    <th>操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var variableStat in Model.VariableStatistics)
                                {
                                    <tr>
                                        <td class="data-display-mobile">@variableStat.VariableName</td>
                                        <td>@variableStat.Count</td>
                                        <td>
                                            @{
                                                // 根据当前时间段计算开始和结束时间
                                                var now = DateTime.Now;
                                                DateTime startTime, endTime;
                                                switch (Model.Period)
                                                {
                                                    case "day":
                                                        startTime = new DateTime(now.Year, now.Month, now.Day);
                                                        endTime = startTime.AddDays(1);
                                                        break;
                                                    case "yesterday":
                                                        startTime = new DateTime(now.Year, now.Month, now.Day).AddDays(-1);
                                                        endTime = startTime.AddDays(1);
                                                        break;
                                                    case "daybefore":
                                                        startTime = new DateTime(now.Year, now.Month, now.Day).AddDays(-2);
                                                        endTime = startTime.AddDays(1);
                                                        break;
                                                    case "week":
                                                        var dayOfWeek = (int)now.DayOfWeek;
                                                        if (dayOfWeek == 0) dayOfWeek = 7; // 将周日视为7
                                                        var startOfWeek = now.Date.AddDays(-(dayOfWeek - 1));
                                                        startTime = new DateTime(startOfWeek.Year, startOfWeek.Month, startOfWeek.Day);
                                                        endTime = startTime.AddDays(7);
                                                        break;
                                                    case "month":
                                                        startTime = new DateTime(now.Year, now.Month, 1);
                                                        endTime = startTime.AddMonths(1);
                                                        break;
                                                    case "custom":
                                                        // 使用自定义时间范围
                                                        startTime = Model.CustomStartTime ?? now.AddDays(-1);
                                                        endTime = Model.CustomEndTime ?? now;
                                                        break;
                                                    default:
                                                        startTime = now.AddDays(-1);
                                                        endTime = now;
                                                        break;
                                                }
                                            }
                                            <a href="/VariableHistory?VariableName=@Uri.EscapeDataString(variableStat.VariableName)&StartTime=@Uri.EscapeDataString(startTime.ToString("yyyy-MM-ddTHH:mm"))&EndTime=@Uri.EscapeDataString(endTime.ToString("yyyy-MM-ddTHH:mm"))"
                                               class="btn btn-sm btn-outline-info btn-mobile-full">查看历史</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p>暂无数据</p>
                }
            </div>
        </div>
    }

    <!-- 历史数据展示 -->
    @if (Model.IsHistoryQuery)
    {
        var variableHistory = Model.VariableHistory;
        <div class="card mb-4">
            <div class="card-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
                <div class="flex-grow-1 mb-2 mb-md-0">
                    <h5 class="card-title mb-0">变量 "@Model.SelectedVariable" 的历史数据</h5>
                    <small class="text-muted">共 @Model.TotalHistoryCount 条记录，第 @Model.PageNumber/@Model.TotalPages 页</small>
                </div>
                <button class="btn btn-sm btn-secondary" onclick="history.back()">返回</button>
            </div>
            <div class="card-body">
                <div class="table-responsive-mobile">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>时间</th>
                                <th>变量名</th>
                                <th>值</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (variableHistory != null && variableHistory.Any())
                            {
                                @foreach (var history in variableHistory)
                                {
                                    <tr>
                                        <td class="data-display-mobile">@history.Time.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td class="data-display-mobile">@history.VariableName</td>
                                        <td class="data-display-mobile">@history.Value</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center">暂无历史数据</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- 分页控件 -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="历史数据分页">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                <form method="post" asp-page-handler="ChangePage" class="d-inline-block">
                                    <input type="hidden" name="variableName" value="@Model.SelectedVariable" />
                                    <input type="hidden" name="pageNumber" value="@(Model.PageNumber - 1)" />
                                    <button type="submit" class="page-link">上一页</button>
                                </form>
                            </li>

                            @for (int i = Math.Max(1, Model.PageNumber - 2); i <= Math.Min(Model.TotalPages, Model.PageNumber + 2); i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <form method="post" asp-page-handler="ChangePage" class="d-inline-block">
                                        <input type="hidden" name="variableName" value="@Model.SelectedVariable" />
                                        <input type="hidden" name="pageNumber" value="@i" />
                                        <button type="submit" class="page-link">@i</button>
                                    </form>
                                </li>
                            }

                            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                                <form method="post" asp-page-handler="ChangePage" class="d-inline-block">
                                    <input type="hidden" name="variableName" value="@Model.SelectedVariable" />
                                    <input type="hidden" name="pageNumber" value="@(Model.PageNumber + 1)" />
                                    <button type="submit" class="page-link">下一页</button>
                                </form>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    }
</div>

<style>
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border: 1px solid rgba(0, 0, 0, 0.125);
    }

    /* 针对小屏幕的额外优化 */
    @@media (max-width: 576px) {
        .display-4-mobile {
            font-size: 1.5rem;
        }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const customTimeForm = document.getElementById('customTimeForm');

            if (customTimeForm) {
                customTimeForm.addEventListener('submit', function(e) {
                    e.preventDefault();

                    const startTime = document.getElementById('customStartTime').value;
                    const endTime = document.getElementById('customEndTime').value;

                    // 验证时间
                    if (!startTime || !endTime) {
                        alert('请选择开始时间和结束时间');
                        return;
                    }

                    if (new Date(startTime) >= new Date(endTime)) {
                        alert('开始时间必须早于结束时间');
                        return;
                    }

                    // 构建 URL 参数
                    const params = new URLSearchParams();
                    params.append('Period', 'custom');
                    params.append('CustomStartTime', startTime);
                    params.append('CustomEndTime', endTime);

                    // 跳转到带参数的 URL
                    window.location.href = window.location.pathname + '?' + params.toString();
                });
            }
        });
    </script>
}