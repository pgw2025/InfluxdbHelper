@page
@model VariableHistoryModel
@{
    ViewData["Title"] = "变量历史记录查询";
}

<div class="container-fluid">
    <h1 class="display-4 mb-4">@ViewData["Title"]</h1>

    @if (!string.IsNullOrEmpty(TempData["ErrorMessage"] as string))
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" id="queryForm">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="VariableName" class="form-label">变量名称</label>
                            <input asp-for="VariableName" class="form-control" id="variableNameInput" placeholder="请输入变量名称" autocomplete="off" />
                            <div id="variableSuggestions" class="list-group position-absolute" style="z-index: 1000; display: none; max-height: 200px; overflow-y: auto; width: 100%;"></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb-3">
                            <label asp-for="StartTime" class="form-label">开始时间</label>
                            <input asp-for="StartTime" type="datetime-local" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group mb-3">
                            <label asp-for="EndTime" class="form-label">结束时间</label>
                            <input asp-for="EndTime" type="datetime-local" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="btn-group" role="group" aria-label="Quick time selection">
                            <button type="button" class="btn btn-outline-secondary btn-sm time-btn" data-range="last1h">最近1小时</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm time-btn" data-range="last3h">最近3小时</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm time-btn" data-range="today">今天</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm time-btn" data-range="yesterday">昨天</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm time-btn" data-range="dayBeforeYesterday">前天</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm time-btn" data-range="thisWeek">本周</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm time-btn" data-range="thisMonth">本月</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm time-btn active" data-range="custom">自定义</button>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <button type="submit" class="btn btn-primary" id="queryBtn">
                            <span id="queryBtnText">查询</span>
                            <span id="querySpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                        </button>
                        <button type="button" class="btn btn-secondary" id="clearBtn">清空</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.QueryResults != null && Model.QueryResults.Any())
    {
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5>查询结果</h5>
                <small>共查询到 @Model.QueryResults.Count 条记录</small>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>时间</th>
                                <th>变量名称</th>
                                <th>值</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.QueryResults)
                            {
                                <tr>
                                    <td>@item.Time.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>@item.VariableName</td>
                                    <td>@item.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (Model.QueryResults != null && !string.IsNullOrEmpty(Model.VariableName))
    {
        <div class="alert alert-info">
            <p>未找到匹配的变量历史记录</p>
        </div>
    }
</div>

<style>
    .time-btn.active {
        background-color: #0d6efd !important;
        border-color: #0d6efd !important;
        color: white !important;
    }

    #variableSuggestions {
        max-height: 200px;
        overflow-y: auto;
        border: 1px solid #ddd;
        border-radius: 0.375rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        background-color: white;
        z-index: 1000;
    }

    .suggestion-item {
        padding: 0.5rem 1rem;
        cursor: pointer;
        border-bottom: 1px solid #eee;
    }

    .suggestion-item:hover {
        background-color: #f8f9fa;
    }

    .suggestion-item:last-child {
        border-bottom: none;
        border-bottom-left-radius: 0.375rem;
        border-bottom-right-radius: 0.375rem;
    }

    .suggestion-item:first-child {
        border-top-left-radius: 0.375rem;
        border-top-right-radius: 0.375rem;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const variableInput = document.getElementById('variableNameInput');
            const suggestionsDiv = document.getElementById('variableSuggestions');
            const queryForm = document.getElementById('queryForm');
            const clearBtn = document.getElementById('clearBtn');
            const queryBtn = document.getElementById('queryBtn');
            const queryBtnText = document.getElementById('queryBtnText');
            const querySpinner = document.getElementById('querySpinner');
            const startTimeInput = document.getElementById('StartTime');
            const endTimeInput = document.getElementById('EndTime');

            // 获取变量名建议 - 改进版，输入一个字符就开始显示建议
            variableInput.addEventListener('input', function() {
                const query = this.value;
                if (query.length >= 1) {  // 从2个字符减少到1个字符开始显示建议
                    // 添加防抖功能
                    clearTimeout(this.debounceTimer);
                    this.debounceTimer = setTimeout(() => {
                        fetch(`/api/variables/autocomplete?query=${encodeURIComponent(query)}`)
                            .then(response => response.json())
                            .then(data => {
                                showSuggestions(data);
                            })
                            .catch(error => {
                                console.error('获取变量建议时出错:', error);
                            });
                    }, 300); // 300ms 防抖延迟
                } else {
                    hideSuggestions();
                }
            });

            variableInput.addEventListener('focus', function() {
                if (this.value.length >= 1) {  // 从2个字符减少到1个字符
                    fetch(`/api/variables/autocomplete?query=${encodeURIComponent(this.value)}`)
                        .then(response => response.json())
                        .then(data => {
                            showSuggestions(data);
                        })
                        .catch(error => {
                            console.error('获取变量建议时出错:', error);
                        });
                }
            });

            variableInput.addEventListener('blur', function() {
                // 延迟隐藏建议框，以便用户可以点击建议项
                setTimeout(() => hideSuggestions(), 200);
            });

            function showSuggestions(suggestions) {
                if (suggestions && suggestions.length > 0) {
                    suggestionsDiv.innerHTML = '';
                    suggestions.forEach(suggestion => {
                        const item = document.createElement('a');
                        item.href = '#';
                        item.className = 'list-group-item list-group-item-action suggestion-item';
                        item.textContent = suggestion;
                        item.onclick = function(e) {
                            e.preventDefault();
                            variableInput.value = suggestion;
                            hideSuggestions();
                        };
                        suggestionsDiv.appendChild(item);
                    });
                    suggestionsDiv.style.display = 'block';
                } else {
                    hideSuggestions();
                }
            }

            function hideSuggestions() {
                suggestionsDiv.style.display = 'none';
            }

            clearBtn.addEventListener('click', function() {
                variableInput.value = '';
                startTimeInput.value = '';
                endTimeInput.value = '';
                hideSuggestions();
            });

            // 表单提交前显示加载状态
            queryForm.addEventListener('submit', function(e) {
                // 获取当前时间字段的值
                const startInput = document.getElementById('StartTime');
                const endInput = document.getElementById('EndTime');

                // 如果时间字段为空，设置默认值（最近24小时）
                if (!startInput.value || !endInput.value) {
                    const now = new Date();
                    const endTime = now;
                    const startTime = new Date(now.getTime() - 24 * 60 * 60 * 1000); // 24小时前

                    if (!startInput.value) {
                        startInput.value = formatDateForInput(startTime);
                    }
                    if (!endInput.value) {
                        endInput.value = formatDateForInput(endTime);
                    }
                }

                // 阻止默认提交行为，手动构建URL进行跳转
                e.preventDefault();

                const variableName = document.getElementById('variableNameInput').value;
                const startTimeValue = startInput.value;
                const endTimeValue = endInput.value;

                // 构建查询参数
                let params = [];
                if (variableName) params.push(`VariableName=${encodeURIComponent(variableName)}`);
                if (startTimeValue) params.push(`StartTime=${encodeURIComponent(startTimeValue)}`);
                if (endTimeValue) params.push(`EndTime=${encodeURIComponent(endTimeValue)}`);

                const queryString = params.join('&');
                const url = queryString ? `?${queryString}` : window.location.pathname + window.location.search;

                queryBtn.disabled = true;
                queryBtnText.textContent = '查询中...';
                querySpinner.classList.remove('d-none');

                // 跳转到带参数的URL
                window.location.href = url;
            });

            // 设置时间范围的函数
            window.setTimeRange = function(range) {
                const now = new Date();
                const startInput = document.getElementById('StartTime');
                const endInput = document.getElementById('EndTime');

                let start, end = now;

                switch(range) {
                    case 'last1h':
                        start = new Date(now.getTime() - 60 * 60 * 1000); // 1 hour ago
                        break;
                    case 'last3h':
                        start = new Date(now.getTime() - 3 * 60 * 60 * 1000); // 3 hours ago
                        break;
                    case 'today':
                        start = new Date(now.getFullYear(), now.getMonth(), now.getDate());
                        end = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
                        break;
                    case 'yesterday':
                        start = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1);
                        end = new Date(now.getFullYear(), now.getMonth(), now.getDate());
                        break;
                    case 'dayBeforeYesterday':
                        start = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 2);
                        end = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1);
                        break;
                    case 'thisWeek':
                        const dayOfWeek = now.getDay();
                        const diff = now.getDate() - dayOfWeek + (dayOfWeek === 0 ? -6 : 1); // Adjust when day is Sunday
                        start = new Date(now.getFullYear(), now.getMonth(), diff);
                        end = new Date(now.getFullYear(), now.getMonth(), diff + 7);
                        break;
                    case 'thisMonth':
                        start = new Date(now.getFullYear(), now.getMonth(), 1);
                        end = new Date(now.getFullYear(), now.getMonth() + 1, 1);
                        break;
                    case 'custom':
                        // For custom, don't change the values, just update button selection
                        updateActiveButton('custom');
                        return;
                    default:
                        return;
                }

                // Format dates to datetime-local format (YYYY-MM-DDTHH:mm)
                startInput.value = formatDateForInput(start);
                endInput.value = formatDateForInput(end);

                // Update active button
                updateActiveButton(range);
            };

            // Update which button is active
            function updateActiveButton(activeRange) {
                const buttons = document.querySelectorAll('.time-btn');
                buttons.forEach(button => {
                    if (button.getAttribute('data-range') === activeRange) {
                        button.classList.add('active');
                        button.classList.remove('btn-outline-secondary');
                        button.classList.add('btn-secondary');
                    } else {
                        button.classList.remove('active');
                        button.classList.remove('btn-secondary');
                        button.classList.add('btn-outline-secondary');
                    }
                });
            }

            // Add event listeners to time buttons
            document.querySelectorAll('.time-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const range = this.getAttribute('data-range');
                    setTimeRange(range);

                    // Remove active class from all buttons except the clicked one
                    document.querySelectorAll('.time-btn').forEach(btn => {
                        btn.classList.remove('active');
                    });
                    this.classList.add('active');
                });
            });

            // Helper function to format date for datetime-local input
            function formatDateForInput(date) {
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                const hours = String(date.getHours()).padStart(2, '0');
                const minutes = String(date.getMinutes()).padStart(2, '0');

                return `${year}-${month}-${day}T${hours}:${minutes}`;
            }
        });
    </script>
}